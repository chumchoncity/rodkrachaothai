<div id="sidebar"
class="w-64 bg-slate-300 text-gray-600
h-screen overflow-y-auto
p-6 font-[kanit]
fixed left-0 top-0
transform
md:translate-x-0 md:static
transition-transform duration-300
z-40">

  <div class="flex justify-end">
    <button id="closeBtn" class="mb-4 text-xl md:hidden">✕</button>
  </div>

  <nav class="space-y-3 text-sm">

    <a href="/admin/dashboard/<%= userId %>"
       class="block px-4 py-2 rounded 
       <%= currentPage === 'dashboard' ? 'bg-slate-200' : 'hover:bg-slate-200' %>">
       แดชบอร์ด
    </a>
    <a href="/admin/articles"
       class="block px-4 py-2 rounded 
       <%= currentPage === 'articles' ? 'bg-slate-200' : 'hover:bg-slate-200' %>">
       บทความ
    </a>
    <a href="/admin/articles/create"
       class="block px-4 py-2 rounded 
       <%= currentPage === 'create-article' ? 'bg-slate-200' : 'hover:bg-slate-200' %>">
       เพิ่มบทความ
    </a>

    <a href="/auth/logout"
       class="block px-4 py-2 mt-6 rounded bg-red-600 hover:bg-red-700 text-gray-100">
       ออกจากระบบ
    </a>

  </nav>
</div>

<script>

const sidebar = document.getElementById("sidebar");
const openBtn = document.getElementById("openBtn");
const closeBtn = document.getElementById("closeBtn");

let startX = 0;
let currentX = 0;
let dragging = false;
let sidebarOpen = false;

function openSidebar() {

    sidebarOpen = true;

    // sidebar.classList.remove("-translate-x-full");
    sidebar.style.transform = "translateX(0)";
    sidebar.style.transition = "transform .3s ease";

}

function closeSidebar() {

    sidebarOpen = false;

    if (window.innerWidth >= 768) return;

    sidebar.style.transform = "translateX(-236px)";
    sidebar.style.transition = "transform .3s ease";

}

// ---------------------
// ปุ่มเปิด / ปิด
// ---------------------

openBtn?.addEventListener("click", openSidebar);
closeBtn?.addEventListener("click", closeSidebar);

// ---------------------
// Swipe
// ---------------------

document.addEventListener("touchstart", (e) => {

    // ถ้า sidebar ปิด ต้องเริ่มปัดจากขอบซ้ายไม่เกิน 30px
    if (!sidebarOpen && e.touches[0].clientX > 30) return;

    dragging = true;

    startX = e.touches[0].clientX;
    currentX = startX;

    sidebar.style.transition = "none";

});

document.addEventListener("touchmove", (e) => {

    if (!dragging) return;

    currentX = e.touches[0].clientX;

    let diff = currentX - startX;

    if (!sidebarOpen) {

        // เปิด
        diff = Math.min(0, -256 + diff);

    } else {

        // ปิด
        diff = Math.min(0, diff);

    }

    sidebar.style.transform = `translateX(${diff}px)`;

});

document.addEventListener("touchend", () => {

    if (!dragging) return;

    dragging = false;

    sidebar.style.transition = "transform .3s ease";

    const diff = currentX - startX;

    if (!sidebarOpen) {

        if (diff > 100) {

            openSidebar();

        } else {

            closeSidebar();

        }

    } else {

        if (diff < -100) {

            closeSidebar();

        } else {

            openSidebar();

        }

    }

});

window.addEventListener("resize", () => {

    if (window.innerWidth >= 768) {

        sidebar.style.transform = "translateX(0)";

    } else {

        closeSidebar();

    }

});

</script>

