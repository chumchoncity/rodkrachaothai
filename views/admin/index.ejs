<div class="max-w-7xl mx-auto pl-6 pr-4 md:p-4 font-[kanit]">
    <h1 class="text-4xl text-slate-100 mt-6 ml-4 md:ml-0">แดชบอร์ด</h1>

    <div class="w-full grid grid-cols-2 lg:grid-cols-3 gap-4 min-h-32 mt-6 md:p-4">
        <div class="rounded bg-slate-800 shadow min-h-32 grid grid-cols-1 md:grid-cols-3 md:gap-2 p-4">
            <div class="col-span-1 flex justify-center items-center">
                <span  class="rounded-full p-2 bg-slate-400 size-12 lg:size-16 flex justify-center items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-article text-slate-800"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 6a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -12" /><path d="M7 8h10" /><path d="M7 12h10" /><path d="M7 16h10" /></svg>
                </span>
            </div>
            <div class="flex flex-col items-center md:items-start flex flex-col items-center md:items-start col-span-2 py-4 text-slate-400">
                <h1 class="text-lg">บทความทั้งหมด</h1>
                <p class="text-4xl"><%= totalArticles %></p>

            </div>
            
        </div>
        <div class="rounded bg-slate-800 shadow min-h-32 grid grid-cols-1 md:grid-cols-3 md:gap-2 p-4">
            <div class="col-span-1 flex justify-center items-center">
                <span class="rounded-full p-2 bg-slate-400 size-12 lg:size-16 flex justify-center items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-square-check text-slate-800"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14" /><path d="M9 12l2 2l4 -4" /></svg>
                </span>
                
            </div>
            <div class="flex flex-col items-center md:items-start col-span-2 py-4 text-slate-400">
                <h1 class="text-lg">บทความที่เผยแพร่</h1>
                <p class="text-4xl"><%= publishedArticles %></p>

            </div>
            
        </div>
        <div class="rounded bg-slate-800 shadow min-h-32 grid grid-cols-1 md:grid-cols-3 md:gap-2 p-4">
            <div class="col-span-1 flex justify-center items-center">
                <span class="rounded-full p-2 bg-slate-400 size-12 lg:size-16 flex justify-center items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye text-slate-800"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                </span>
                
            </div>
            <div class="flex flex-col items-center md:items-start col-span-2 py-4 text-slate-400">
                <h1 class="text-lg">ยอดวิวบทความ</h1>
                <p class="text-4xl"><%= Number(totalViews).toLocaleString("en-US") %></p>

            </div>
            
        </div>
        <div class="rounded bg-slate-800 shadow min-h-32 grid grid-cols-1 md:grid-cols-3 md:gap-2 p-4">
            <div class="col-span-1 flex justify-center items-center">
                <span class="rounded-full p-2 bg-slate-400 size-12 lg:size-16 flex justify-center items-center">
                    
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-bulldozer text-slate-800"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M2 17a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M12 17a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M19 13v4a2 2 0 0 0 2 2h1" /><path d="M14 19h-10" /><path d="M4 15h10" /><path d="M9 11v-5h2a3 3 0 0 1 3 3v6" /><path d="M5 15v-3a1 1 0 0 1 1 -1h8" /><path d="M19 17h-3" /></svg>
                </span>
                
            </div>
            <div class="flex flex-col items-center md:items-start col-span-2 py-4 text-slate-400">
                <h1 class="text-lg">เครื่องจักรทั้งหมด</h1>
                <p class="text-4xl"><%= Number(totalMachines).toLocaleString("en-US") %></p>

            </div>
            
        </div>
        <div class="rounded bg-slate-800 shadow min-h-32 grid grid-cols-1 md:grid-cols-3 md:gap-2 p-4">
            <div class="col-span-1 flex justify-center items-center">
                <span class="rounded-full p-2 bg-slate-400 size-12 lg:size-16 flex justify-center items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye text-slate-800"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                </span>
                
            </div>
            <div class="flex flex-col items-center md:items-start col-span-2 py-4 text-slate-400">
                <h1 class="text-lg">ยอดวิวเครื่องจักร</h1>
                <p class="text-4xl"><%= Number(totalViewsMachines).toLocaleString("en-US") %></p>

            </div>
            
        </div>

    </div>

    <div class="w-full mt-6 md:p-4">
        <div class="bg-slate-800 rounded shadow p-4 text-slate-400">

            <h2 class="font-semibold text-lg mb-4 text-slate-100">
                Popular Machines
            </h2>

            <% popularMachines.forEach(machine => { %>

                <a
                    href="/machines/<%= machine.slug %>"
                    class="flex items-center gap-4 py-3 px-2 border-b hover:bg-slate-700 transition rounded">

                    <img
                        src="/images/machines/<%= machine.machine_image %>"
                        class="w-16 h-16 rounded-lg object-cover">

                    <div class="flex-1">

                        <h3 class="font-medium">
                            <%= machine.brand_name %>
                            <%= machine.model %>
                        </h3>

                        <p class="text-sm text-gray-500">
                            Working Height
                            <%= machine.working_height %> m
                        </p>

                    </div>

                    <div class="text-right">

                        <div class="font-semibold text-orange-500">
                            <%= machine.view_count %>
                        </div>

                        <div class="text-xs text-gray-400">
                            Views
                        </div>

                    </div>

                </a>

            <% }) %>

        </div>

    </div>

</div>
