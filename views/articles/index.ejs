<div class="min-h-screen">
    <section class="relative text-center min-h-[40vh] md:min-h-[60vh] w-full">
        <div class="absolute inset-0 max-w-7xl mx-auto p-6 flex flex-col z-10 h-full">
            <div class="text-gray-100 font-[kanit] p-4">
                <h2 class="text-3xl md:text-5xl font-semibold text-start p-1">บทความ</h2>
                <h2 class="text-2xl md:text-3xl font-semibold text-start p-1 text-orange-400">ARTICLES</h2>
                <p class="text-xl md:text-2xl text-start p-1">รถกระเช้าไทย ผู้เชี่ยวชาญด้านรถกระเช้าและงานที่สูงครบวงจร</p>

            </div>
        </div>
        

        
        <div
            class="absolute inset-0 bg-cover bg-right md:bg-center"
            style="background-image: url('/images/bg-hero.png');" alt="รถกระเช้าไทย">
        </div>

        
        <div
            class="absolute inset-0 bg-gradient-to-r from-slate-900 via-blue-900/80 to-sky-700/20">
        </div>
        
    </section>


    <section class="w-full bg-white font-[kanit] text-gray-700 min-h-[60vh]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="p-4 font-semibold">
                <h1 class="text-2xl text-blue-900">บทความล่าสุด</h1>
            </div>
            <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 py-10">

                <% articles.forEach(article => { %>
                <div class="h-96 grid grid-rows-5 gap-1 rounded border-2 border-slate-300 shadow">
                    <div class="bg-white row-span-3">
                        <img src="/images/articles/<%= article.featured_image %>" alt="<%= article.og_title %>" class="w-full h-full object-cover">
                    </div>
                    <div class="row-span-2 p-2 grid grid-rows-3">
                        <div class="row-span-2">
                            <h1 class="text-lg text-blue-900 font-semibold"><%= article.title %></h1>
                            <p class="text-blue-900">
                                <%= article.short_description %>
                            </p>
                        </div>
                        <div class="grid grid-cols-5 items-end">
                            <div class="col-span-2 flex gap-1 text-sm font-light items-center">
                                <span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-week"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12" /><path d="M16 3v4" /><path d="M8 3v4" /><path d="M4 11h16" /><path d="M7 14h.013" /><path d="M10.01 14h.005" /><path d="M13.01 14h.005" /><path d="M16.015 14h.005" /><path d="M13.015 17h.005" /><path d="M7.01 17h.005" /><path d="M10.01 17h.005" /></svg></span>
                                <p>
                                    <%= new Date(article.created_at).toLocaleDateString('th-TH', {
                                        day: 'numeric',
                                        month: 'short',
                                        year: '2-digit'
                                    }) %>
                                </p>
                            </div>
                            <div class="col-span-1 text-sm font-light flex gap-1 items-center">
                                <span><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg></span>
                                <p>
                                    <%= article.view_count %>
                                </p>
                            </div>
                            <div class="col-span-2 flex justify-end text-sm">
                                <a href="/articles/<%= article.slug %>" class="flex text-orange-500 hover:text-orange-600">
                                    อ่านต่อ
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            

            
            
        </div>     
    </section>






    

</div>