<div class="max-w-5xl mx-auto p-8">

    <h1 class="text-3xl font-bold mb-8 text-slate-100">
    เพิ่มบทความ
    </h1>

    <form
    action="/admin/articles/create"
    method="POST"
    enctype="multipart/form-data"
    class="space-y-6 text-slate-400"
    >

        <!-- Title -->

        <div>

            <label class="font-semibold">
            หัวข้อบทความ
            </label>

            <input
            type="text"
            name="title"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100 bg-slate-900 border-slate-700 text-slate-100"
            required>

        </div>

        <!-- Slug -->

        <div>

            <label class="font-semibold">
            Slug
            </label>

            <input
            type="text"
            name="slug"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100 bg-slate-900 border-slate-700 text-slate-100">

        </div>

        <!-- Excerpt -->

        <div>

            <label class="font-semibold">
            คำอธิบายสั้น
            </label>

            <textarea
            name="short_description"
            rows="3"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100 bg-slate-900 border-slate-700 text-slate-100"
            ></textarea>

        </div>

        <!-- Content -->

        <div>

            <label class="font-semibold">
            เนื้อหา
            </label>

            <textarea
            name="content"
            rows="15"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100 bg-slate-900 border-slate-700 text-slate-100"
            ></textarea>

        </div>

        <!-- Featured -->

        <div>
            <label class="block font-semibold mb-2">
                รูปหน้าปก
            </label>

            <label
                for="featured_image"
                class="inline-flex items-center px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded cursor-pointer transition">
                เลือกรูปหน้าปก
            </label>

            <span id="file-name" class="ml-3 text-slate-400 text-sm">
                ยังไม่ได้เลือกไฟล์
            </span>

            <input
                id="featured_image"
                type="file"
                name="featured_image"
                accept="image/*"
                class="hidden">
        </div>

        <script>
            const featuredImage = document.getElementById('featured_image');
            const fileName = document.getElementById('file-name');

            featuredImage.addEventListener('change', function () {
                fileName.textContent = this.files.length
                    ? this.files[0].name
                    : 'ยังไม่ได้เลือกไฟล์';
            });
        </script>

        <hr>

        <h2 class="text-2xl font-bold text-slate-100">
        SEO
        </h2>

        <!-- Meta Title -->

        <div>

            <label>
            Meta Title
            </label>

            <input
            type="text"
            name="meta_title"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100 bg-slate-900 border-slate-700 text-slate-100">

        </div>

        <!-- Meta Description -->

        <div>

            <label>
            Meta Description
            </label>

            <textarea
            name="meta_description"
            rows="3"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100"
            ></textarea>

        </div>

        <!-- OG Title -->

        <div>

            <label>
            OG Title
            </label>

            <input
            type="text"
            name="og_title"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100">

        </div>

        <!-- OG Description -->

        <div>

            <label>
            OG Description
            </label>

            <textarea
            name="og_description"
            rows="3"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100"
            ></textarea>

        </div>

        <div>

            <label>
            Canonical Url
            </label>

            <input
            type="text"
            name="canonical_url"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100">

        </div>

        <!-- Keywords -->

        <div>

            <label>
            Keywords
            </label>

            <input
            type="text"
            name="keywords"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100">

        </div>

        <!-- Status -->

        <div>

            <label>
            บทความแนะนำ
            </label>

            <select
            name="is_featured"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100">

            <option value="0">
                ไม่แนะนำ
            </option>

            <option value="1">
                แนะนำ
            </option>

            </select>

        </div>

        <!-- Status -->

        <div>

            <label>
            สถานะ
            </label>

            <select
            name="status"
            class="w-full border rounded p-2 bg-slate-900 border-slate-700 text-slate-100">

            <option value="draft">
            Draft
            </option>

            <option value="published">
            Published
            </option>

            </select>

        </div>

        <button
        class="bg-orange-600 text-slate-100 px-8 py-3 rounded hover:bg-orange-700">

        บันทึกบทความ

        </button>

    </form>

</div>