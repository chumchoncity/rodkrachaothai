<div class="max-w-7xl mx-auto pr-2 pl-6 lg:p-4 font-[kanit]">

    <div class="flex justify-between items-center my-6">

        <h1 class="text-2xl md:text-4xl font-semibold text-slate-100 ml-4 md:ml-0">
            บทความทั้งหมด
        </h1>

        <a
            href="/admin/articles/create"
            class="bg-blue-600 text-white px-4 py-2 rounded">

            + เพิ่มบทความ

        </a>

    </div>

    <div class="bg-slate-800 rounded shadow overflow-hidden text-slate-400">

        <table class="w-full">

            <tbody>

            <% articles.forEach(article => { %>

                <tr class="border-t">

                    <td class="pl-4 lg:p-2">

                        <img
                            src="/images/articles/<%= article.featured_image %>"
                            class="w-28 h-16 object-cover rounded">
                        <div class="text-sm md:text-md md:font-semibold mt-2">
                            <%= article.title %>
                        </div>

                        <div class="text-sm text-gray-500 text-[11px] md:text-sm">

                            /articles/<%= article.slug %>

                        </div>

                    </td>

                    <td class="text-center items-center">
                        <span class="flex justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye text-slate-400"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                        </span>

                        <%= article.view_count.toLocaleString() %>

                    </td>

                    <td class="text-center">

                        <div class="flex flex-col gap-1">
                            <% if(article.status=="published"){ %>

                            <span class="text-green-400 px-3 py-1 rounded-full text-sm">

                                Published

                            </span>

                            <% }else{ %>

                                <span class="text-yellow-700 px-3 py-1 rounded-full text-sm">

                                    Draft

                                </span>

                            <% } %>
                            
                            <span class="text-sm">
                                <%=
                            article.published_at
                            ? new Date(article.published_at).toLocaleDateString("th-TH")
                            : "-"
                            %>
                            </span>
                        </div>

                    </td>

                    <td>

                        <div class="flex justify-center flex-col lg:flex-row gap-2 p-2">

                            <a
                                href="/articles/<%= article.slug %>"
                                target="_blank"
                                class="text-slate-600 px-3 py-1 rounded bg-slate-200 w-full text-center hover:bg-slate-300 transition">

                                ดู

                            </a>

                            <a
                                href="/admin/articles/edit/<%= article.id %>"
                                class="px-3 py-1 rounded bg-blue-600 text-white w-full text-center hover:bg-blue-700 transition">

                                แก้ไข

                            </a>

                            <form action="/admin/articles/delete/<%= article.id %>" method="POST"
                                onsubmit="return confirm('ยืนยันการลบบทความ?')"
                                class="bg-red-600 text-white px-3 py-1 rounded w-full text-center hover:bg-red-700 transition"
                                >

                                <button
                                    class="">
                                    ลบ
                                </button>

                            </form>

                        </div>

                    </td>

                </tr>

            <% }) %>

            </tbody>

        </table>

    </div>

</div>