<div id="sidebar"
class="w-64 bg-slate-900 text-gray-600
h-screen overflow-y-auto
py-6 font-[kanit]
fixed left-0 top-0
transform
md:translate-x-0 md:static
transition-transform duration-300
z-40">

  <div class="flex justify-end p-4">
    <button id="closeBtn" class="mb-4 text-xl md:hidden text-slate-100">✕</button>
  </div>

  <nav class="space-y-3 text-sm mt-10 p-4">

    <a href="/admin/dashboard/<%= userId %>"
       class="flex gap-2 items-center px-4 py-3 rounded text-slate-100
       <%= currentPage === 'dashboard' ? 'bg-slate-900' : 'hover:bg-slate-900' %>">
       <span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-gauge"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /><path d="M13.41 10.59l2.59 -2.59" /><path d="M7 12a5 5 0 0 1 5 -5" /></svg>
       </span>
       แดชบอร์ด
    </a>
    <div x-data="{ openArticle: <%= ['articles', 'create-article'].includes(currentPage) ? 'true' : 'false' %> }">

        <!-- เมนูหลัก -->
        <button
            @click="openArticle = !openArticle"
            class="w-full flex items-center justify-between px-4 py-3 hover:bg-slate-900 rounded text-slate-100">

            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M3 6a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -12"/>
                    <path d="M7 8h10"/>
                    <path d="M7 12h10"/>
                    <path d="M7 16h10"/>
                </svg>

                <span>บทความ</span>
            </div>

            <!-- ลูกศร -->
            <svg
                class="w-4 h-4 transition-transform"
                :class="{ 'rotate-180': openArticle }"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">

                <path stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"/>
            </svg>
        </button>

        <!-- Dropdown -->
        <div x-show="openArticle" x-transition>

            <a href="/admin/articles"
                class="block pl-12 pr-4 py-3 rounded text-slate-100
                <%= currentPage === 'articles'
                    ? 'bg-slate-900 font-medium'
                    : 'hover:bg-slate-900' %>">

                รายการบทความ
            </a>

            <a href="/admin/articles/create"
                class="block pl-12 pr-4 py-3 text-slate-100
                <%= currentPage === 'create-article'
                    ? 'bg-slate-900 font-medium'
                    : 'hover:bg-slate-900' %>">

                เพิ่มบทความ
            </a>

        </div>

    </div>

    <a href="/auth/logout"
       class="flex gap-2 items-center px-4 py-4 text-slate-100">
       <span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-logout"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" /><path d="M9 12h12l-3 -3" /><path d="M18 15l3 -3" /></svg>
       </span>
       ออกจากระบบ
    </a>

  </nav>
</div>

<script>

const sidebar = document.getElementById("sidebar");
const openBtn = document.getElementById("openBtn");
const closeBtn = document.getElementById("closeBtn");

let startX = 0;
let currentX = 0;
let dragging = false;
let sidebarOpen = false;

function openSidebar() {

    sidebarOpen = true;

    // sidebar.classList.remove("-translate-x-full");
    sidebar.style.transform = "translateX(0)";
    sidebar.style.transition = "transform .3s ease";

}

function closeSidebar() {

    sidebarOpen = false;

    if (window.innerWidth >= 768) return;

    sidebar.style.transform = "translateX(-236px)";
    sidebar.style.transition = "transform .3s ease";

}

// ---------------------
// ปุ่มเปิด / ปิด
// ---------------------

openBtn?.addEventListener("click", openSidebar);
closeBtn?.addEventListener("click", closeSidebar);

// ---------------------
// Swipe
// ---------------------

document.addEventListener("touchstart", (e) => {

    // ถ้า sidebar ปิด ต้องเริ่มปัดจากขอบซ้ายไม่เกิน 30px
    if (!sidebarOpen && e.touches[0].clientX > 30) return;

    dragging = true;

    startX = e.touches[0].clientX;
    currentX = startX;

    sidebar.style.transition = "none";

});

document.addEventListener("touchmove", (e) => {

    if (!dragging) return;

    currentX = e.touches[0].clientX;

    let diff = currentX - startX;

    if (!sidebarOpen) {

        // เปิด
        diff = Math.min(0, -256 + diff);

    } else {

        // ปิด
        diff = Math.min(0, diff);

    }

    sidebar.style.transform = `translateX(${diff}px)`;

});

document.addEventListener("touchend", () => {

    if (!dragging) return;

    dragging = false;

    sidebar.style.transition = "transform .3s ease";

    const diff = currentX - startX;

    if (!sidebarOpen) {

        if (diff > 100) {

            openSidebar();

        } else {

            closeSidebar();

        }

    } else {

        if (diff < -100) {

            closeSidebar();

        } else {

            openSidebar();

        }

    }

});

window.addEventListener("resize", () => {

    if (window.innerWidth >= 768) {

        sidebar.style.transform = "translateX(0)";

    } else {

        closeSidebar();

    }

});

</script>

