<div class="max-w-7xl mx-auto pl-6 pr-4 md:p-4 font-[kanit]">
    <h1 class="text-4xl text-slate-100 mt-6 ml-4 md:ml-0">แดชบอร์ด</h1>

    <div class="w-full grid md:grid-cols-2 lg:grid-cols-3 gap-4 min-h-32 mt-6">
        <div class="rounded bg-slate-800 shadow min-h-32 grid grid-cols-3 gap-2">
            <div class="col-span-1 flex justify-center items-center">
                <span  class="rounded-full p-4 bg-slate-400 w-20 h-20 flex justify-center items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-article text-slate-800"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 6a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2l0 -12" /><path d="M7 8h10" /><path d="M7 12h10" /><path d="M7 16h10" /></svg>
                </span>
            </div>
            <div class="col-span-2 py-4 text-slate-400">
                <h1 class="text-lg">บทความทั้งหมด</h1>
                <p class="text-5xl"><%= totalArticles %></p>

            </div>
            
        </div>
        <div class="rounded bg-slate-800 shadow min-h-32 grid grid-cols-3 gap-2">
            <div class="col-span-1 flex justify-center items-center">
                <span class="rounded-full p-4 bg-slate-400 w-20 h-20 flex justify-center items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-square-check text-slate-800"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14" /><path d="M9 12l2 2l4 -4" /></svg>
                </span>
                
            </div>
            <div class="col-span-2 py-4 text-slate-400">
                <h1 class="text-lg">บทความที่เผยแพร่</h1>
                <p class="text-5xl"><%= publishedArticles %></p>

            </div>
            
        </div>
        <div class="rounded bg-slate-800 shadow min-h-32 grid grid-cols-3 gap-2">
            <div class="col-span-1 flex justify-center items-center">
                <span class="rounded-full p-4 bg-slate-400 w-20 h-20 flex justify-center items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye text-slate-800"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                </span>
                
            </div>
            <div class="col-span-2 py-4 text-slate-400">
                <h1 class="text-lg">ยอดวิวทั้งหมด</h1>
                <p class="text-5xl"><%= Number(totalViews).toLocaleString("en-US") %></p>

            </div>
            
        </div>

    </div>

</div>
