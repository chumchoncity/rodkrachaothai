<div class="max-w-7xl mx-auto p-6">

    <div class="flex justify-between items-center mb-6">

        <h1 class="text-2xl font-bold">
            บทความทั้งหมด
        </h1>

        <a
            href="/admin/articles/create"
            class="bg-blue-600 text-white px-4 py-2 rounded">

            + เพิ่มบทความ

        </a>

    </div>

    <div class="bg-white rounded shadow overflow-hidden">

        <table class="w-full">

            <thead class="bg-gray-100">

                <tr>

                    <th class="p-4 text-left">
                        รูป
                    </th>

                    <th class="p-4 text-left">
                        หัวข้อ
                    </th>

                    <th class="p-4">
                        Views
                    </th>

                    <th class="p-4">
                        สถานะ
                    </th>

                    <th class="p-4">
                        วันที่เผยแพร่
                    </th>

                    <th class="p-4">
                        จัดการ
                    </th>

                </tr>

            </thead>

            <tbody>

            <% articles.forEach(article => { %>

                <tr class="border-t">

                    <td class="p-4">

                        <img
                            src="/images/articles/<%= article.featured_image %>"
                            class="w-28 h-16 object-cover rounded">

                    </td>

                    <td class="p-4">

                        <div class="font-semibold">
                            <%= article.title %>
                        </div>

                        <div class="text-sm text-gray-500">

                            /articles/<%= article.slug %>

                        </div>

                    </td>

                    <td class="text-center">

                        <%= article.view_count.toLocaleString() %>

                    </td>

                    <td class="text-center">

                        <% if(article.status=="published"){ %>

                            <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">

                                Published

                            </span>

                        <% }else{ %>

                            <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm">

                                Draft

                            </span>

                        <% } %>

                    </td>

                    <td class="text-center">

                        <%=
                        article.published_at
                        ? new Date(article.published_at).toLocaleDateString("th-TH")
                        : "-"
                        %>

                    </td>

                    <td>

                        <div class="flex justify-center gap-2">

                            <a
                                href="/articles/<%= article.slug %>"
                                target="_blank"
                                class="px-3 py-1 rounded bg-slate-200">

                                ดู

                            </a>

                            <a
                                href="/admin/articles/edit/<%= article.id %>"
                                class="px-3 py-1 rounded bg-blue-600 text-white">

                                แก้ไข

                            </a>

                            <form action="/admin/articles/delete/<%= article.id %>" method="POST"
                                onsubmit="return confirm('ยืนยันการลบบทความ?')">

                                <button
                                    class="bg-red-600 text-white px-3 py-1 rounded">
                                    ลบ
                                </button>

                            </form>

                        </div>

                    </td>

                </tr>

            <% }) %>

            </tbody>

        </table>

    </div>

</div>